# ------------------------------------------------------------------
# Escudo Comunitario - Frontend (.env.example)
# Copia este archivo como .env y completa los valores.
# Prefijo VITE_: las variables se exponen al navegador, NO pongas secretos.
# ------------------------------------------------------------------

# URL base del backend FastAPI (Vercel o local)
VITE_API_URL=http://localhost:8000

# Configuración pública de Firebase (web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
