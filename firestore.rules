rules_version = '2';

// Escudo Comunitario - Reglas de Firestore
//
// El navegador SOLO puede leer información anonimizada. Nadie puede escribir
// desde el cliente: todos los reportes entran por el backend (Admin SDK, que
// no está sujeto a estas reglas), donde se analizan, se encadenan y se sellan.
//
//   panel_publico         reportes anonimizados para el panel territorial
//   registros             bloques de la cadena: reportes y seguimiento del caso (sin datos personales)
//   alertas_comunitarias  brotes de fraude por UPZ
//
// Privadas (solo backend): alertas_bosa, cadena, indicadores, conversaciones,
// suscriptores_alertas, avisos_caso, retroalimentacion.
service cloud.firestore {
  match /databases/{database}/documents {

    match /panel_publico/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /registros/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /alertas_comunitarias/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Todo lo demás (incluida alertas_bosa, con los casos completos) queda cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
