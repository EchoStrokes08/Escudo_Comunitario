# ------------------------------------------------------------------
# Escudo Comunitario - Backend (.env.example)
# Copia este archivo como .env y completa tus credenciales.
# NUNCA subas el .env real al repositorio.
# ------------------------------------------------------------------

# --- Twilio (canal WhatsApp) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# --- Firebase ---
# JSON completo de la service account, guardado como una sola línea
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# --- LLM (detección avanzada) ---
# Proveedor: gemini | openai | heuristico
# Las API keys admiten varias separadas por comas (clave1,clave2): si una falla o se
# queda sin cuota se prueba la siguiente; el otro proveedor (si tiene clave) es el respaldo final
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Alternativa OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT=15

# --- Archivos adjuntos (multimodal) ---
MAX_ARCHIVOS=3
MAX_PESO_MB=2

# --- CORS ---
# Lista separada por comas de orígenes permitidos (frontend de Vercel + localhost)
CORS_ORIGINS=http://localhost:5173,https://tu-frontend.vercel.app
