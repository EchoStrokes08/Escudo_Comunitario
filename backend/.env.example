# ------------------------------------------------------------------
# Escudo Comunitario - Backend (.env.example)
# Copia este archivo como .env y completa tus credenciales.
# NUNCA subas el .env real al repositorio.
# ------------------------------------------------------------------

# --- Twilio (canal WhatsApp) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# Remitente para alertas a líderes (sandbox de Twilio: whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=
# La firma X-Twilio-Signature se valida si hay TWILIO_AUTH_TOKEN. Si Twilio apunta a otra URL, ponla aquí:
TWILIO_WEBHOOK_URL=
TWILIO_VALIDAR_FIRMA=true

# --- Firebase ---
# JSON completo de la service account, guardado como una sola línea
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# --- LLM (detección avanzada) ---
# Proveedor inicial: groq | gemini | openai | heuristico (los demás con clave quedan de respaldo)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MODELOS_RESPALDO=openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_MODELO_AUDIO=whisper-large-v3-turbo

# Las API keys admiten varias separadas por comas (clave1,clave2): si una falla o se
# queda sin cuota se prueba la siguiente; el otro proveedor (si tiene clave) es el respaldo final
GEMINI_API_KEY=
# Si el modelo no existe se prueban GEMINI_MODELOS_RESPALDO en orden (diagnóstico: GET /api/estado?probar_ia=1)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODELOS_RESPALDO=gemini-3.5-flash,gemini-flash-lite-latest,gemini-flash-latest,gemini-3.8-flash
# Alternativa OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT=15
LLM_PRESUPUESTO=30

# --- Archivos adjuntos (multimodal) ---
MAX_ARCHIVOS=3
MAX_PESO_MB=2
MAX_PESO_AUDIO_MB=4

# --- Verificación en fuentes abiertas (RDAP, marcas y acortadores funcionan sin clave) ---
VERIFICACION_TIMEOUT=4
# Opcionales (gratis): https://auth.abuse.ch  y  Google Cloud > Safe Browsing API
URLHAUS_AUTH_KEY=
GOOGLE_SAFE_BROWSING_KEY=

# --- Privacidad: sal del seudónimo del reportante (cámbiala y no la publiques) ---
SAL_SEUDONIMO=cambia-esta-sal

# --- Telegram (gratis): crea el bot con @BotFather y luego corre scripts/configurar_telegram.py ---
TELEGRAM_BOT_TOKEN=

# --- WhatsApp oficial de Meta (gratis, número de prueba): developers.facebook.com > app > WhatsApp ---
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
# Texto que pegas en Meta como "Token de verificación" del webhook
META_VERIFY_TOKEN=escudo-comunitario-bosa
META_APP_SECRET=

# --- Alertas comunitarias: líderes que reciben aviso de brotes por UPZ ---
# (Los líderes también pueden suscribirse gratis escribiendo /alertas al bot de Telegram)
LIDERES_WHATSAPP=
BROTE_MINIMO=3
BROTE_VENTANA_HORAS=48

# --- Vista de autoridades (/autoridades) y reanclaje: token compartido ---
AUTORIDADES_TOKEN=

# --- Respuestas en audio (veredicto hablado en Telegram, WhatsApp y la web) ---
# Usa la voz gratuita de Google Translate (no oficial); si falla, el bot responde solo con texto
VOZ_RESPUESTAS=true
VOZ_TLD=com.mx
VOZ_TIMEOUT=6

# --- URL pública del frontend (enlaces y QR de certificados) ---
APP_URL=https://escudocomunitario.vercel.app

# --- CORS ---
# Lista separada por comas de orígenes permitidos (frontend de Vercel + localhost)
CORS_ORIGINS=http://localhost:5173,https://tu-frontend.vercel.app
